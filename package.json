{
	"name": "LabelCascade",
	"version": "1.0.0",
	"description": "Google Apps Script project to sync parent labels for Gmail",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "pnpm run typecheck && pnpm run lint",
		"typecheck": "tsc --noEmit",
		"build": "node scripts/build.mjs",
		"lint": "biome check . --write",
		"format": "biome format --write .",
		"login": "clasp login",
		"create": "clasp create --title \"LabelCascade\" --type standalone --rootDir ./dist",
		"push": "node scripts/push.mjs",
		"push:watch": "clasp push --watch",
		"deploy": "node scripts/deploy.mjs",
		"pull": "clasp pull",
		"open": "clasp open-script"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.9.1",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@google/clasp": "^3.4.1",
		"@types/google-apps-script": "^2.0.13",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2"
	}
}
